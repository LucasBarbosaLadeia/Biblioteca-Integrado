# Exemplo de variáveis de ambiente para todo o projeto
# Copie o conteúdo apropriado para cada pasta (back/, Front-End/..., Microservicos/...) e preencha os valores reais.

# BACKEND (back/.env)
NODE_ENV=development
PORT=3001
DB_HOST=database
DB_PORT=3306
DB_USER=app
DB_PASSWORD=123456
DB_NAME=biblioteca
BACK_API=http://localhost:3001/
ENABLE_RESERVAS_JOB=false
RESERVAS_JOB_INTERVAL_MINUTES=5
TEST_RESERVA_EXPIRE_MINUTES=2
JWT_SECRET=your_jwt_secret_here
NOTIFY_URL=http://notification:3005/notify
TIMEZONE=America/Sao_Paulo

# FRONT-END (Front-End/Biblioteca-Integrado/.env)
# Use o IP da sua máquina ou localhost conforme o ambiente (emulador vs device)
API_HOST=http://localhost:3001

# MICROSERVIÇOS
# Microserviço Emprestimos (Microservicos/emprestimos/.env)
PORT=3002
BACKEND=http://localhost:3001/api

# Microserviço Notification (Microservicos/notification/.env)
PORT=3005

# Instruções rápidas:
# - Renomeie/copiar `.env.example` para `.env` dentro de cada serviço e ajuste os valores.
# - Para o frontend (React Native / Expo) use o plugin @env ou react-native-config conforme o projeto.
# - No Docker Compose, prefira passar essas variáveis via `environment` ou arquivos `.env` específicos por serviço.
